mo:puntoDevolucion rdfs:comment "Relación «punto de devolución» cuyo sujeto pertenece a ServicioDeMovilidad y cuyo objeto pertenece a PuntoDeServicio en el modelo de movilidad compartida."@es .
mo:puntoRecogida rdfs:comment "Relación «punto de recogida» cuyo sujeto pertenece a ServicioDeMovilidad y cuyo objeto pertenece a PuntoDeServicio en el modelo de movilidad compartida."@es .
mo:realizadoPor rdfs:comment "Relación «realizado por» cuyo sujeto pertenece a Pago y cuyo objeto pertenece a Agentes en el modelo de movilidad compartida."@es .
mo:registradoEnPlataforma rdfs:comment "Relación «registrado en plataforma» cuyo sujeto pertenece a Persona en el modelo de movilidad compartida."@es .
mo:reservaEn rdfs:comment "Relación «reserva en» cuyo sujeto pertenece a Reserva y cuyo objeto pertenece a PuntoDeServicio en el modelo de movilidad compartida."@es .
mo:reservaServicio rdfs:comment "Relación «reserva servicio» cuyo sujeto pertenece a Reserva y cuyo objeto pertenece a ServicioDeMovilidad en el modelo de movilidad compartida."@es .
mo:tienePago rdfs:comment "Relación «tiene pago» cuyo sujeto pertenece a Factura y cuyo objeto pertenece a Pago en el modelo de movilidad compartida."@es .
mo:tieneRol rdfs:comment "Relación «tiene rol» cuyo sujeto pertenece a Organizacion y cuyo objeto pertenece a Rol en el modelo de movilidad compartida."@es .
mo:tieneTarifa rdfs:comment "Relación «tiene tarifa» cuyo sujeto pertenece a ServicioDeMovilidad y cuyo objeto pertenece a Tarifa en el modelo de movilidad compartida."@es .
mo:tieneTrayecto rdfs:comment "Relación «tiene trayecto» cuyo sujeto pertenece a ServicioDeMovilidad y cuyo objeto pertenece a RelacionTrayecto en el modelo de movilidad compartida."@es .
mo:validez rdfs:comment "Relación «validez» cuyo sujeto pertenece a TarifaBonoPrepago en el modelo de movilidad compartida."@es .
mo:ReservaInmediata rdfs:comment "Reserva que permite iniciar el uso del servicio sin programación anticipada."@es .
mo:TarifaBonoPrepago rdfs:comment "Tarifa basada en la compra anticipada de un bono de usos."@es .
mo:TarifaPagoUso rdfs:comment "Tarifa cuyo coste depende del uso realizado."@es .
mo:EstacionFisica rdfs:comment "Punto físico habilitado como estación de movilidad compartida."@es .
mo:Organizacion rdfs:comment "Entidad organizativa que participa en servicios de movilidad compartida."@es .
mo:ReservaAnticipada rdfs:comment "Reserva realizada para una fecha u hora futura."@es .
mo:Pago rdfs:comment "Operación económica asociada a la contratación o uso de un servicio."@es .
mo:Persona rdfs:comment "Agente individual que participa en la movilidad compartida."@es .
mo:RelacionTrayecto rdfs:comment "Relación que vincula un trayecto con su coste y duración."@es .
mo:Tarifa rdfs:comment "Condiciones económicas aplicables al uso de un servicio de movilidad compartida."@es .
mo:Agente rdfs:comment "Participante en el sistema de movilidad compartida."@es .
mo:Factura rdfs:comment "Documento que registra los importes facturados por servicios o trayectos."@es .
mo:Reserva rdfs:comment "Solicitud de utilización de un servicio o vehículo de movilidad compartida."@es .
mo:ServicioDeMovilidad rdfs:comment "Oferta de movilidad compartida gestionada por un agente."@es .
mo:PuntoDeServicio rdfs:comment "Infraestructura donde se ofrece, recoge o devuelve un servicio o vehículo compartido."@es .
mo:VehiculoCompartido rdfs:comment "Vehículo destinado a servicios de movilidad compartida."@es .

# Particiones OWL del modelo: disyunción y cobertura cuando son exhaustivas.
mo:Reserva owl:equivalentClass [ a owl:Class ; owl:unionOf ( mo:ReservaInmediata mo:ReservaAnticipada ) ] .
mo:ReservaInmediata owl:disjointWith mo:ReservaAnticipada .
mo:PuntoDeServicio owl:equivalentClass [ a owl:Class ; owl:unionOf ( mo:EstacionFisica mo:OficinaDeAlquiler mo:Aparcamiento ) ] .
[] a owl:AllDisjointClasses ; owl:members ( mo:EstacionFisica mo:OficinaDeAlquiler mo:Aparcamiento ) .
# Clasificación exhaustiva y disjunta de los vehículos según su propulsión.
mo:VehiculoCompartido rdfs:subClassOf [ a owl:Class ; owl:unionOf ( mo:VehiculoPropulsionElectrica mo:VehiculoPropulsionHibrida mo:VehiculoPropulsionCombustible mo:VehiculoPropulsionHumana ) ] .
[] a owl:AllDisjointClasses ; owl:members ( mo:VehiculoPropulsionElectrica mo:VehiculoPropulsionHibrida mo:VehiculoPropulsionCombustible mo:VehiculoPropulsionHumana ) .
# Clasificación de vehículos personales/colectivos: partición del diagrama.
mo:VehiculoCompartido rdfs:subClassOf [ a owl:Class ; owl:unionOf ( mo:VehiculoMovilidadPersonal mo:VehiculoColectivo ) ] .
mo:VehiculoMovilidadPersonal owl:disjointWith mo:VehiculoColectivo .
# Las tarifas son disjuntas, sin imponer exhaustividad.
[] a owl:AllDisjointClasses ; owl:members ( mo:TarifaSuscripcion mo:TarifaBonoPrepago mo:TarifaPagoUso ) .
# Suscripciones: subtipos disjuntos, sin cobertura obligatoria.
[] a owl:AllDisjointClasses ; owl:members ( mo:TarifaSuscripcionDiaria mo:TarifaSuscripcionMensual mo:TarifaSuscripcionAnual ) .

# Propiedades inversas propias para navegación bidireccional (OOPS! P13).
mo:haceReserva owl:inverseOf mo:reservaRealizadaPor .
mo:reservaRealizadaPor a owl:ObjectProperty ;
    rdfs:domain mo:Reserva ;
    rdfs:range mo:Persona ;
    rdfs:label "reserva realizada por"@es ;
    rdfs:comment "Relación inversa de mo:haceReserva."@es .

mo:reservaVehiculo owl:inverseOf mo:vehiculoReservadoEn .
mo:vehiculoReservadoEn a owl:ObjectProperty ;
    rdfs:domain mo:VehiculoCompartido ;
    rdfs:range mo:Reserva ;
    rdfs:label "vehiculo reservado en"@es ;
    rdfs:comment "Relación inversa de mo:reservaVehiculo."@es .

mo:reservaServicio owl:inverseOf mo:servicioReservadoEn .
mo:servicioReservadoEn a owl:ObjectProperty ;
    rdfs:domain mo:ServicioDeMovilidad ;
    rdfs:range mo:Reserva ;
    rdfs:label "servicio reservado en"@es ;
    rdfs:comment "Relación inversa de mo:reservaServicio."@es .

mo:ofreceServicio owl:inverseOf mo:servicioOfrecidoPor .
mo:servicioOfrecidoPor a owl:ObjectProperty ;
    rdfs:domain mo:ServicioDeMovilidad ;
    rdfs:range mo:Agente ;
    rdfs:label "servicio ofrecido por"@es ;
    rdfs:comment "Relación inversa de mo:ofreceServicio."@es .

mo:tieneTarifa owl:inverseOf mo:tarifaDeServicio .
mo:tarifaDeServicio a owl:ObjectProperty ;
    rdfs:domain mo:Tarifa ;
    rdfs:range mo:ServicioDeMovilidad ;
    rdfs:label "tarifa de servicio"@es ;
    rdfs:comment "Relación inversa de mo:tieneTarifa."@es .

mo:disponeDe owl:inverseOf mo:vehiculoDisponibleEnServicio .
mo:vehiculoDisponibleEnServicio a owl:ObjectProperty ;
    rdfs:domain mo:VehiculoCompartido ;
    rdfs:range mo:ServicioDeMovilidad ;
    rdfs:label "vehiculo disponible en servicio"@es ;
    rdfs:comment "Relación inversa de mo:disponeDe."@es .

mo:estacionadoEn owl:inverseOf mo:estacionaVehiculo .
mo:estacionaVehiculo a owl:ObjectProperty ;
    rdfs:domain mo:PuntoDeServicio ;
    rdfs:range mo:VehiculoCompartido ;
    rdfs:label "estaciona vehiculo"@es ;
    rdfs:comment "Relación inversa de mo:estacionadoEn."@es .

mo:emitidaPor owl:inverseOf mo:emiteFactura .
mo:emiteFactura a owl:ObjectProperty ;
    rdfs:domain mo:Agente ;
    rdfs:range mo:Factura ;
    rdfs:label "emite factura"@es ;
    rdfs:comment "Relación inversa de mo:emitidaPor."@es .

mo:emitidaA owl:inverseOf mo:recibeFactura .
mo:recibeFactura a owl:ObjectProperty ;
    rdfs:domain mo:Agente ;
    rdfs:range mo:Factura ;
    rdfs:label "recibe factura"@es ;
    rdfs:comment "Relación inversa de mo:emitidaA."@es .

mo:tienePago owl:inverseOf mo:pagoDeFactura .
mo:pagoDeFactura a owl:ObjectProperty ;
    rdfs:domain mo:Pago ;
    rdfs:range mo:Factura ;
    rdfs:label "pago de factura"@es ;
    rdfs:comment "Relación inversa de mo:tienePago."@es .

mo:realizadoPor owl:inverseOf mo:realizaPago .
mo:realizaPago a owl:ObjectProperty ;
    rdfs:domain mo:Agente ;
    rdfs:range mo:Pago ;
    rdfs:label "realiza pago"@es ;
    rdfs:comment "Relación inversa de mo:realizadoPor."@es .

mo:tieneRol owl:inverseOf mo:rolDeAgente .
mo:rolDeAgente a owl:ObjectProperty ;
    rdfs:domain mo:Rol ;
    rdfs:range mo:Agente ;
    rdfs:label "rol de agente"@es ;
    rdfs:comment "Relación inversa de mo:tieneRol."@es .


# Declaraciones explícitas de clases reutilizadas (OOPS! P34).
skos:Concept a owl:Class .
foaf:Person a owl:Class .
<http://schema.mobivoc.org/#ParkingFacility> a owl:Class .
<http://schema.mobivoc.org/#BatteryElectricVehicle> a owl:Class .
<http://schema.mobivoc.org/#Plug-inHybridElectricVehicle> a owl:Class .
<http://purl.org/goodrelations/v1#BusinessEntity> a owl:Class .


# Ontologia y SKOS recopilados para cargar directamente en Protege. No incluye instancias de ejemplo.

@prefix cc: <http://creativecommons.org/ns#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix edintkos: <https://edint.es/kos/> .
@prefix edintpropulsionsystemtype: <https://edint.es/kos/PropulsionSystemType/> .
@prefix edintvehiclestate: <https://edint.es/kos/VehicleState/> .
@prefix estado: <https://example.org/ontologia-movilidad/estado#> .
@prefix estur-kos: <https://ontologia.segittur.es/turismo/kos/> .
@prefix estur-paymentmethod: <https://ontologia.segittur.es/turismo/kos/paymentmethod/> .
@prefix estur-stationtype: <https://ontologia.segittur.es/turismo/kos/stationtype/> .
@prefix estur-vehicletype: <https://ontologia.segittur.es/turismo/kos/vehicletype/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix gr: <http://purl.org/goodrelations/v1#> .
@prefix inv: <http://purl.org/net/oeg/keychain/invoice#> .
@prefix mo: <http://movilidad.es/def/compartida#> .
@prefix mv: <http://purl.org/net/mobivic#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prop: <https://example.org/ontologia-movilidad/propulsion#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://movilidad.es/def/compartida> a owl:Ontology ;
    dct:created "2026-10-26"^^xsd:date ;
    dct:description "Ontología para la representación de servicios de movilidad compartida, agentes, vehículos, reservas y tarifas."@es ;
    dct:title "Ontología de Movilidad Compartida (myOntology)"@es ;
    vann:preferredNamespacePrefix "mo" ;
    vann:preferredNamespaceUri "http://movilidad.es/def/compartida#" ;
    rdfs:seeAlso edintkos:PropulsionSystemType,
        edintkos:VehicleState,
        estado:EstadoVehiculo,
        prop:Propulsion,
        estur-kos:PaymentMethod,
        estur-kos:StationType,
        estur-kos:VehicleType ;
    owl:versionInfo "1.0.0" .

mo:EstacionBicicletas a owl:Class ;
    rdfs:subClassOf mo:EstacionFisica .

mo:EstacionBus a owl:Class ;
    rdfs:subClassOf mo:EstacionFisica .

mo:EstacionFerroviaria a owl:Class ;
    rdfs:subClassOf mo:EstacionFisica .

mo:NIF a owl:DatatypeProperty ;
    rdfs:domain mo:Organizacion ;
    rdfs:range xsd:string .

mo:ParkingPrivadoConcertado a owl:Class ;
    rdfs:subClassOf mo:PuntoDeServicio ;
    owl:equivalentClass mv:ParkingFacility .

mo:RolProveedor a owl:Class ;
    rdfs:subClassOf mo:Rol .

mo:RolUsuario a owl:Class ;
    rdfs:subClassOf mo:Rol ;
    owl:equivalentClass mv:UserGroup .

mo:TarifaSuscripcionAnual a owl:Class ;
    rdfs:subClassOf mo:TarifaSuscripcion .

mo:TarifaSuscripcionDiaria a owl:Class ;
    rdfs:subClassOf mo:TarifaSuscripcion .

mo:TarifaSuscripcionMensual a owl:Class ;
    rdfs:subClassOf mo:TarifaSuscripcion .

mo:VehiculoColectivo a owl:Class ;
    rdfs:subClassOf mo:VehiculoCompartido .

mo:VehiculoMovilidadPersonal a owl:Class ;
    rdfs:subClassOf mo:VehiculoCompartido .

mo:VehiculoPropulsionCombustible a owl:Class ;
    rdfs:subClassOf mo:VehiculoCompartido ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( mo:VehiculoCompartido [ a owl:Restriction ;
                        owl:hasValue prop:Combustion ;
                        owl:onProperty mo:tienePropulsion ] ) ] .

mo:VehiculoPropulsionElectrica a owl:Class ;
    rdfs:subClassOf mo:VehiculoCompartido ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( mo:VehiculoCompartido [ a owl:Restriction ;
                        owl:hasValue prop:Electrica ;
                        owl:onProperty mo:tienePropulsion ] ) ],
        mv:ElectricVehicle .

mo:VehiculoPropulsionHibrida a owl:Class ;
    rdfs:subClassOf mo:VehiculoCompartido ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( mo:VehiculoCompartido [ a owl:Restriction ;
                        owl:hasValue prop:Hibrida ;
                        owl:onProperty mo:tienePropulsion ] ) ] .

mo:VehiculoPropulsionHumana a owl:Class ;
    rdfs:subClassOf mo:VehiculoCompartido ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( mo:VehiculoCompartido [ a owl:Restriction ;
                        owl:hasValue prop:Humana ;
                        owl:onProperty mo:tienePropulsion ] ) ] .

mo:ViaPublica a owl:Class ;
    rdfs:subClassOf mo:PuntoDeServicio .

mo:activa a owl:DatatypeProperty ;
    rdfs:domain mo:Reserva ;
    rdfs:range xsd:boolean .

mo:activo a owl:DatatypeProperty ;
    rdfs:domain mo:ServicioDeMovilidad ;
    rdfs:range xsd:boolean .

mo:apellidos a owl:DatatypeProperty ;
    rdfs:domain mo:Persona ;
    rdfs:range xsd:string .

mo:asignaTrayecto a owl:ObjectProperty ;
    rdfs:domain mo:RelacionTrayecto ;
    rdfs:range mo:Trayecto .

mo:baseRecarga a owl:DatatypeProperty ;
    rdfs:domain mo:PuntoDeServicio ;
    rdfs:range xsd:boolean .

mo:cancelable a owl:DatatypeProperty ;
    rdfs:domain mo:ReservaAnticipada ;
    rdfs:range xsd:boolean .

mo:capacidad a owl:DatatypeProperty ;
    rdfs:domain mo:VehiculoCompartido ;
    rdfs:range xsd:integer .

mo:contratoServicio a owl:ObjectProperty ;
    rdfs:domain mo:Agentes ;
    rdfs:range mo:ServicioDeMovilidad .

mo:costeTrayecto a owl:DatatypeProperty ;
    rdfs:domain mo:RelacionTrayecto ;
    rdfs:range xsd:decimal .

mo:descripcion a owl:DatatypeProperty ;
    rdfs:domain mo:ServicioDeMovilidad ;
    rdfs:range xsd:string .

mo:direccion a owl:DatatypeProperty ;
    rdfs:domain mo:PuntoDeServicio ;
    rdfs:range xsd:string .

mo:disponeDe a owl:ObjectProperty ;
    rdfs:domain mo:ServicioDeMovilidad ;
    rdfs:range mo:VehiculoCompartido .

mo:distanciaKm a owl:DatatypeProperty ;
    rdfs:domain mo:RelacionTrayecto ;
    rdfs:range xsd:decimal .

mo:duracionMinutos a owl:DatatypeProperty ;
    rdfs:domain mo:RelacionTrayecto ;
    rdfs:range xsd:decimal .

mo:emitidaA a owl:ObjectProperty ;
    rdfs:domain mo:Factura ;
    rdfs:range mo:Agentes .

mo:emitidaPor a owl:ObjectProperty ;
    rdfs:domain mo:Factura ;
    rdfs:range mo:Agentes .

mo:estacionadoEn a owl:ObjectProperty ;
    rdfs:domain mo:VehiculoCompartido ;
    rdfs:range mo:PuntoDeServicio .

mo:facturaServicio a owl:ObjectProperty ;
    rdfs:domain mo:Factura ;
    rdfs:range mo:ServicioDeMovilidad .

mo:facturaTrayecto a owl:ObjectProperty ;
    rdfs:domain mo:Factura ;
    rdfs:range mo:RelacionTrayecto .

mo:fechaEmision a owl:DatatypeProperty ;
    rdfs:domain mo:Factura ;
    rdfs:range xsd:dateTime .

mo:fechaFin a owl:DatatypeProperty ;
    rdfs:domain mo:ReservaAnticipada ;
    rdfs:range xsd:dateTime .

mo:fechaInicio a owl:DatatypeProperty ;
    rdfs:domain mo:ReservaAnticipada ;
    rdfs:range xsd:dateTime .

mo:fechaNacimiento a owl:DatatypeProperty ;
    rdfs:domain mo:Persona ;
    rdfs:range xsd:date .

mo:fechaPago a owl:DatatypeProperty ;
    rdfs:domain mo:Pago ;
    rdfs:range xsd:dateTime .

mo:fechaReserva a owl:DatatypeProperty ;
    rdfs:domain mo:Reserva ;
    rdfs:range xsd:dateTime .

mo:haceReserva a owl:ObjectProperty ;
    rdfs:domain mo:Persona ;
    rdfs:range mo:Reserva .

mo:hasDestination a owl:ObjectProperty ;
    rdfs:domain mo:MultiStopRelation ;
    rdfs:range mo:PuntoDeServicio .

mo:hasMultiStop a owl:ObjectProperty ;
    rdfs:domain mo:Trayecto ;
    rdfs:range mo:MultiStopRelation .

mo:hasNextStop a owl:ObjectProperty ;
    rdfs:domain mo:MultiStopRelation ;
    rdfs:range mo:MultiStopRelation .

mo:idAgente a owl:DatatypeProperty ;
    rdfs:domain mo:Agentes ;
    rdfs:range xsd:string .

mo:idFactura a owl:DatatypeProperty ;
    rdfs:domain mo:Factura ;
    rdfs:range xsd:string .

mo:idPago a owl:DatatypeProperty ;
    rdfs:domain mo:Pago ;
    rdfs:range xsd:string .

mo:idPunto a owl:DatatypeProperty ;
    rdfs:domain mo:PuntoDeServicio ;
    rdfs:range xsd:string .

mo:idReserva a owl:DatatypeProperty ;
    rdfs:domain mo:Reserva ;
    rdfs:range xsd:string .

mo:idServicio a owl:DatatypeProperty ;
    rdfs:domain mo:ServicioDeMovilidad ;
    rdfs:range xsd:string .

mo:idTarifa a owl:DatatypeProperty ;
    rdfs:domain mo:Tarifa ;
    rdfs:range xsd:string .

mo:idTrayecto a owl:DatatypeProperty ;
    rdfs:domain mo:Trayecto ;
    rdfs:range xsd:string .

mo:idVehiculo a owl:DatatypeProperty ;
    rdfs:domain mo:VehiculoCompartido ;
    rdfs:range xsd:string .

mo:importe a owl:DatatypeProperty ;
    rdfs:domain mo:Pago ;
    rdfs:range xsd:decimal .

mo:importeTotal a owl:DatatypeProperty ;
    rdfs:domain mo:Factura ;
    rdfs:range xsd:decimal .

mo:inicioUso a owl:DatatypeProperty ;
    rdfs:domain mo:ReservaInmediata ;
    rdfs:range xsd:dateTime .

mo:kilometraje a owl:DatatypeProperty ;
    rdfs:domain mo:VehiculoCompartido ;
    rdfs:range xsd:decimal .

mo:latitud a owl:DatatypeProperty ;
    rdfs:domain mo:PuntoDeServicio ;
    rdfs:range xsd:decimal .

mo:longitud a owl:DatatypeProperty ;
    rdfs:domain mo:PuntoDeServicio ;
    rdfs:range xsd:decimal .

mo:matricula a owl:DatatypeProperty ;
    rdfs:domain mo:VehiculoCompartido ;
    rdfs:range xsd:string .

mo:minutosCortesia a owl:DatatypeProperty ;
    rdfs:domain mo:Reserva ;
    rdfs:range xsd:integer .

mo:moneda a owl:DatatypeProperty ;
    rdfs:range xsd:string .

mo:nUsos a owl:DatatypeProperty ;
    rdfs:domain mo:TarifaBonoPrepago ;
    rdfs:range xsd:integer .

mo:nombreAgente a owl:DatatypeProperty ;
    rdfs:domain mo:Agentes ;
    rdfs:range xsd:string .

mo:nombrePunto a owl:DatatypeProperty ;
    rdfs:domain mo:PuntoDeServicio ;
    rdfs:range xsd:string .

mo:nombreServicio a owl:DatatypeProperty ;
    rdfs:domain mo:ServicioDeMovilidad ;
    rdfs:range xsd:string .

mo:nombreTarifa a owl:DatatypeProperty ;
    rdfs:domain mo:Tarifa ;
    rdfs:range xsd:string .

mo:ofreceServicio a owl:ObjectProperty ;
    rdfs:domain mo:Agentes ;
    rdfs:range mo:ServicioDeMovilidad .

mo:ofrecidoEn a owl:ObjectProperty ;
    rdfs:domain mo:ServicioDeMovilidad ;
    rdfs:range mo:PuntoDeServicio .

mo:pagadoCon a owl:ObjectProperty ;
    rdfs:comment "Los valores son conceptos del esquema de SEGITTUR https://ontologia.segittur.es/turismo/kos/PaymentMethod."@es ;
    rdfs:domain mo:Tarifa ;
    rdfs:range skos:Concept .

mo:pendientePago a owl:DatatypeProperty ;
    rdfs:domain mo:Factura ;
    rdfs:range xsd:boolean .

mo:permisoConducir a owl:DatatypeProperty ;
    rdfs:domain mo:Persona ;
    rdfs:range xsd:boolean .

mo:precio a owl:DatatypeProperty ;
    rdfs:domain mo:Tarifa ;
    rdfs:range xsd:decimal .

mo:precioKm a owl:DatatypeProperty ;
    rdfs:domain mo:TarifaPagoUso ;
    rdfs:range xsd:decimal .

mo:precioMinuto a owl:DatatypeProperty ;
    rdfs:domain mo:TarifaPagoUso ;
    rdfs:range xsd:decimal .

mo:puntoDevolucion a owl:ObjectProperty ;
    rdfs:domain mo:ServicioDeMovilidad ;
    rdfs:range mo:PuntoDeServicio .

mo:puntoRecogida a owl:ObjectProperty ;
    rdfs:domain mo:ServicioDeMovilidad ;
    rdfs:range mo:PuntoDeServicio .

mo:realizadoPor a owl:ObjectProperty ;
    rdfs:domain mo:Pago ;
    rdfs:range mo:Agentes .

mo:registradoEnPlataforma a owl:DatatypeProperty ;
    rdfs:domain mo:Persona ;
    rdfs:range xsd:boolean .

mo:reservaEn a owl:ObjectProperty ;
    rdfs:domain mo:Reserva ;
    rdfs:range mo:PuntoDeServicio .

mo:reservaServicio a owl:ObjectProperty ;
    rdfs:domain mo:Reserva ;
    rdfs:range mo:ServicioDeMovilidad .

mo:reservaVehiculo a owl:ObjectProperty ;
    rdfs:domain mo:Reserva ;
    rdfs:range mo:VehiculoCompartido .

mo:tieneEstado a owl:ObjectProperty ;
    rdfs:comment "Los valores son conceptos del esquema https://example.org/ontologia-movilidad/estado#EstadoVehiculo."@es ;
    rdfs:domain mo:VehiculoCompartido ;
    rdfs:range skos:Concept .

mo:tieneMetodoPago a owl:ObjectProperty ;
    rdfs:comment "Los valores son conceptos del esquema de SEGITTUR https://ontologia.segittur.es/turismo/kos/PaymentMethod."@es ;
    rdfs:domain mo:Pago ;
    rdfs:range skos:Concept .

mo:tienePago a owl:ObjectProperty ;
    rdfs:domain mo:Factura ;
    rdfs:range mo:Pago .

mo:tieneRol a owl:ObjectProperty ;
    rdfs:domain mo:Organizacion,
        mo:Persona ;
    rdfs:range mo:Rol .

mo:tieneTarifa a owl:ObjectProperty ;
    rdfs:domain mo:ServicioDeMovilidad ;
    rdfs:range mo:Tarifa .

mo:tieneTrayecto a owl:ObjectProperty ;
    rdfs:domain mo:ServicioDeMovilidad ;
    rdfs:range mo:RelacionTrayecto .

mo:tipo a owl:DatatypeProperty ;
    rdfs:domain mo:Organizacion ;
    rdfs:range xsd:string .

mo:tipoEstacion a owl:ObjectProperty ;
    rdfs:comment "Los valores son conceptos del esquema de SEGITTUR https://ontologia.segittur.es/turismo/kos/StationType."@es ;
    rdfs:domain mo:PuntoDeServicio ;
    rdfs:range skos:Concept .

mo:tipoVehiculo a owl:ObjectProperty ;
    rdfs:comment "Los valores son conceptos del esquema de SEGITTUR https://ontologia.segittur.es/turismo/kos/VehicleType."@es ;
    rdfs:domain mo:VehiculoCompartido ;
    rdfs:range skos:Concept .

mo:validez a owl:DatatypeProperty ;
    rdfs:domain mo:TarifaBonoPrepago ;
    rdfs:range xsd:date .

gr:offers a owl:ObjectProperty .

edintvehiclestate:Abandoned a skos:Concept ;
    skos:inScheme edintkos:VehicleState ;
    skos:prefLabel "Abandoned"@en,
        "Abandonado"@es .

edintvehiclestate:Active a skos:Concept ;
    skos:inScheme edintkos:VehicleState ;
    skos:prefLabel "Active"@en,
        "Activo"@es .

edintvehiclestate:Inactive a skos:Concept ;
    skos:inScheme edintkos:VehicleState ;
    skos:prefLabel "Inactive"@en,
        "Inactivo"@es .


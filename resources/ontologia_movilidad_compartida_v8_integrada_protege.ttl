# Ontologia V8 y siete vocabularios SKOS: grafo integrado para Protege.
# Los prefijos son abreviaturas; las IRIs oficiales se conservan.

# Fuente: ontologia/ontologia_movilidad_compartida_v8.ttl
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix segittur: <https://ontologia.segittur.es/turismo/kos/> .
@prefix sg: <https://ontologia.segittur.es/turismo/def/core#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix mo: <http://movilidad.es/def/compartida#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://movilidad.es/def/compartida> a owl:Ontology ;
    dcterms:created "2026-10-26"^^xsd:date ;
    dcterms:description "Ontología para la representación de servicios de movilidad compartida, agentes, vehículos, reservas y tarifas."@es ;
    dcterms:title "Ontología de Movilidad Compartida (myOntology)"@es ;
    vann:preferredNamespacePrefix "mo" ;
    vann:preferredNamespaceUri "http://movilidad.es/def/compartida#" ;
    rdfs:comment "Los esquemas SKOS propios usan el espacio de nombres mo: conforme a la notacion del diagrama V8. Los vocabularios SEGITTUR se mantienen con sus IRIs oficiales; las referencias oficiales a sus esquemas son segittur:PaymentMethod, segittur:VehicleType y segittur:StationType."@es,
        "Versión 8 alineada con el diagrama. Los módulos externos MobiVoc, SEGITTUR y GeoSPARQL se referencian sin reproducir sus axiomas. Las equivalencias de propulsión externa requieren verificación semántica."@es ;
    rdfs:seeAlso mo:EstadoVehiculoScheme,
        mo:TipoPropulsionScheme,
        <http://schema.mobivoc.org/#AccessCondition>,
        <http://schema.mobivoc.org/#ArrangementPattern>,
        <http://schema.mobivoc.org/#Capacity>,
        <http://schema.mobivoc.org/#Charger>,
        <http://schema.mobivoc.org/#CivicStructureStatus>,
        <http://schema.mobivoc.org/#ParkingFacility>,
        <http://schema.mobivoc.org/#ParkingFacilityConnection>,
        <http://schema.mobivoc.org/#ParkingFacilityEntrance>,
        <http://schema.mobivoc.org/#ParkingFacilityExit>,
        <http://schema.mobivoc.org/#ParkingFacilityFeature>,
        <http://schema.mobivoc.org/#ParkingSpace>,
        <http://schema.mobivoc.org/#Plug>,
        <http://schema.mobivoc.org/#PlugType>,
        <http://schema.mobivoc.org/#RealTimeCapacity>,
        geo:Feature,
        geo:Geometry,
        <https://edint.es/kos/PropulsionSystemType>,
        <https://edint.es/kos/VehicleState>,
        sg:HorarioDeApertura,
        sg:InfraestructuraDeTransporte,
        sg:Localizacion,
        sg:Lugar,
        segittur:PaymentMethod,
        segittur:StationType,
        segittur:VehicleType,
        schema:CivicStructure ;
    owl:versionInfo "1.0.0-v8" .

mo:EstacionBicicletas a owl:Class ;
    rdfs:subClassOf mo:EstacionFisica .

mo:EstacionBus a owl:Class ;
    rdfs:subClassOf mo:EstacionFisica .

mo:EstacionFerroviaria a owl:Class ;
    rdfs:subClassOf mo:EstacionFisica .

mo:NIF a owl:DatatypeProperty ;
    rdfs:domain mo:Organizacion ;
    rdfs:range xsd:string .

mo:ParkingPrivadoConcertadoPublico a owl:Class ;
    rdfs:subClassOf mo:PuntoDeServicio,
        <http://schema.mobivoc.org/#ParkingFacility> .

mo:RolProveedor a owl:Class ;
    rdfs:subClassOf mo:Rol .

mo:RolUsuario a owl:Class ;
    rdfs:subClassOf mo:Rol .

mo:TarifaSuscripcionAnual a owl:Class ;
    rdfs:subClassOf mo:TarifaSuscripcion .

mo:TarifaSuscripcionDiaria a owl:Class ;
    rdfs:subClassOf mo:TarifaSuscripcion .

mo:TarifaSuscripcionMensual a owl:Class ;
    rdfs:subClassOf mo:TarifaSuscripcion .

mo:VehiculoColectivo a owl:Class ;
    rdfs:subClassOf mo:VehiculoCompartido .

mo:VehiculoMovilidadPersonal a owl:Class ;
    rdfs:subClassOf mo:VehiculoCompartido .

mo:VehiculoPropulsionCombustible a owl:Class ;
    rdfs:subClassOf mo:VehiculoCompartido ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( mo:VehiculoCompartido [ a owl:Restriction ;
                        owl:hasValue mo:Combustion ;
                        owl:onProperty mo:tienePropulsion ] ) ] .

mo:VehiculoPropulsionElectrica a owl:Class ;
    rdfs:seeAlso <http://schema.mobivoc.org/#BatteryElectricVehicle> ;
    rdfs:subClassOf mo:VehiculoCompartido ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( mo:VehiculoCompartido [ a owl:Restriction ;
                        owl:hasValue mo:Electrica ;
                        owl:onProperty mo:tienePropulsion ] ) ] .

mo:VehiculoPropulsionHibrida a owl:Class ;
    rdfs:seeAlso <http://schema.mobivoc.org/#Plug-inHybridElectricVehicle> ;
    rdfs:subClassOf mo:VehiculoCompartido ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( mo:VehiculoCompartido [ a owl:Restriction ;
                        owl:hasValue mo:Hibrida ;
                        owl:onProperty mo:tienePropulsion ] ) ] .

mo:VehiculoPropulsionHumana a owl:Class ;
    rdfs:subClassOf mo:VehiculoCompartido ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( mo:VehiculoCompartido [ a owl:Restriction ;
                        owl:hasValue mo:Humana ;
                        owl:onProperty mo:tienePropulsion ] ) ] .


mo:tipoVehiculo a owl:ObjectProperty ;
    rdfs:comment "Los valores son conceptos del esquema segittur:VehicleType de SEGITTUR."@es ;
    rdfs:domain mo:VehiculoCompartido ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso segittur:VehicleType .

mo:validez a owl:DatatypeProperty ;
    rdfs:domain mo:TarifaBonoPrepago ;
    rdfs:range xsd:date .

<http://purl.org/goodrelations/v1#offers> a owl:ObjectProperty .

mo:ReservaInmediata a owl:Class ;
    rdfs:subClassOf mo:Reserva .

mo:TarifaBonoPrepago a owl:Class ;
    rdfs:subClassOf mo:Tarifa .

mo:TarifaPagoUso a owl:Class ;
    rdfs:subClassOf mo:Tarifa .

mo:EstacionFisica a owl:Class ;
    rdfs:subClassOf mo:PuntoDeServicio .

mo:Organizacion a owl:Class ;
    rdfs:subClassOf mo:Agentes ;
    owl:equivalentClass <http://purl.org/goodrelations/v1#BusinessEntity>,
        foaf:Organization .

mo:ReservaAnticipada a owl:Class ;
    rdfs:subClassOf mo:Reserva .

mo:Rol a owl:Class .

mo:TarifaSuscripcion a owl:Class ;
    rdfs:subClassOf mo:Tarifa .

mo:Trayecto a owl:Class .

mo:MultiStopRelation a owl:Class .

mo:tienePropulsion a owl:ObjectProperty ;
    rdfs:comment "Los valores son conceptos del esquema mo:TipoPropulsionScheme."@es ;
    rdfs:domain mo:VehiculoCompartido ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso mo:TipoPropulsionScheme .

mo:Pago a owl:Class .

mo:Persona a owl:Class ;
    rdfs:subClassOf mo:Agentes ;
    owl:equivalentClass foaf:Person .

mo:RelacionTrayecto a owl:Class .

mo:Tarifa a owl:Class .

mo:Agentes a owl:Class .

mo:Factura a owl:Class .

mo:Reserva a owl:Class .

mo:ServicioDeMovilidad a owl:Class .

mo:PuntoDeServicio a owl:Class .

mo:VehiculoCompartido a owl:Class .

# Fuente: skos/edint/propulsionsystemtype.ttl
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix edintvehcom: <https://edint.es/def/vehiculos-compartidos#> .
@prefix edint: <https://edint.es/kos/> .
@prefix edintpropulsionsystemtype: <https://edint.es/kos/PropulsionSystemType/> .

#################################################################
#
#    Concept Scheme
#
#################################################################

edint:PropulsionSystemType a skos:ConceptScheme ;
  dct:issued "2026-05-21"^^xsd:date ;
  dct:modified "2026-05-21"^^xsd:date ;
  rdfs:comment "This concept scheme belongs to the set of controlled SKOS-based thesauri used by the ontologies from the EDINT data space."@en ;
  rdfs:comment "Este esquema de conceptos pertenece al conjunto de tesauros SKOS usados por las ontologías del espacio de datos EDINT."@es ;
  rdfs:label "Propulsion system type"@en ;
  rdfs:label "Tipo de sistema de propulsión"@es ;
  dct:title "Concept scheme grouping propulsion system types"@en ;
  dct:title "Esquema de conceptos agrupando tipos de sistema de propulsión"@es .

#################################################################
#
#    Concepts
#
#################################################################

edintpropulsionsystemtype:Electric a skos:Concept ;
  skos:inScheme edint:PropulsionSystemType ;
  skos:prefLabel "Electric"@en ;
  skos:prefLabel "Eléctrico"@es .

edintpropulsionsystemtype:Diesel a skos:Concept ;
  skos:inScheme edint:PropulsionSystemType ;
  skos:prefLabel "Diesel"@en ;
  skos:prefLabel "Diesel"@es .

edintpropulsionsystemtype:Gasoline a skos:Concept ;
  skos:inScheme edint:PropulsionSystemType ;
  skos:prefLabel "Gasoline"@en ;
  skos:prefLabel "Gasolina"@es .

edintpropulsionsystemtype:Hybrid a skos:Concept ;
  skos:inScheme edint:PropulsionSystemType ;
  skos:prefLabel "Hybrid"@en ;
  skos:prefLabel "Híbrido"@es .

# Fuente: skos/edint/vehiclestate.ttl
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix edintvehcom: <https://edint.es/def/vehiculos-compartidos#> .
@prefix edint: <https://edint.es/kos/> .
@prefix edintvehiclestate: <https://edint.es/kos/VehicleState/> .

#################################################################
#
#    Concept Scheme
#
#################################################################

edint:VehicleState a skos:ConceptScheme ;
  dct:issued "2026-05-21"^^xsd:date ;
  dct:modified "2026-05-21"^^xsd:date ;
  rdfs:comment "This concept scheme belongs to the set of controlled SKOS-based thesauri used by the ontologies from the EDINT data space."@en ;
  rdfs:comment "Este esquema de conceptos pertenece al conjunto de tesauros SKOS usados por las ontologías del espacio de datos EDINT."@es ;
  rdfs:label "Vehicle state"@en ;
  rdfs:label "Estado del vehículo"@es ;
  dct:title "Concept scheme grouping vehicle states"@en ;
  dct:title "Esquema de conceptos agrupando estados de vehículo"@es .

#################################################################
#
#    Concepts
#
#################################################################

edintvehiclestate:Active a skos:Concept ;
  skos:inScheme edint:VehicleState ;
  skos:prefLabel "Active"@en ;
  skos:prefLabel "Activo"@es .

edintvehiclestate:Inactive a skos:Concept ;
  skos:inScheme edint:VehicleState ;
  skos:prefLabel "Inactive"@en ;
  skos:prefLabel "Inactivo"@es .

edintvehiclestate:UnderRepair a skos:Concept ;
  skos:inScheme edint:VehicleState ;
  skos:prefLabel "Under repair"@en ;
  skos:prefLabel "En reparación"@es .

edintvehiclestate:Abandoned a skos:Concept ;
  skos:inScheme edint:VehicleState ;
  skos:prefLabel "Abandoned"@en ;
  skos:prefLabel "Abandonado"@es .

# Fuente: skos/propios/estado_vehiculo.ttl
@prefix edint-estado: <https://edint.es/kos/VehicleState/> .
@prefix mo: <http://movilidad.es/def/compartida#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

mo:Disponible a skos:Concept ;
    skos:inScheme mo:EstadoVehiculoScheme ;
    skos:prefLabel "Available"@en,
        "Disponible"@es ;
    skos:topConceptOf mo:EstadoVehiculoScheme .

mo:Mantenimiento a skos:Concept ;
    skos:closeMatch edint-estado:UnderRepair ;
    skos:inScheme mo:EstadoVehiculoScheme ;
    skos:prefLabel "Under maintenance"@en,
        "Mantenimiento"@es ;
    skos:topConceptOf mo:EstadoVehiculoScheme .

mo:Ocupado a skos:Concept ;
    skos:inScheme mo:EstadoVehiculoScheme ;
    skos:prefLabel "Occupied"@en,
        "Ocupado"@es ;
    skos:topConceptOf mo:EstadoVehiculoScheme .

mo:EstadoVehiculoScheme a skos:ConceptScheme ;
    skos:hasTopConcept mo:Disponible,
        mo:Mantenimiento,
        mo:Ocupado ;
    skos:prefLabel "Vehicle status"@en,
        "Estado del vehículo"@es .

# Fuente: skos/propios/tipo_propulsion.ttl
@prefix edint-prop: <https://edint.es/kos/PropulsionSystemType/> .
@prefix mo: <http://movilidad.es/def/compartida#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

mo:Combustion a skos:Concept ;
    skos:inScheme mo:TipoPropulsionScheme ;
    skos:narrowMatch edint-prop:Diesel,
        edint-prop:Gasoline ;
    skos:prefLabel "Combustion"@en,
        "Combustión"@es ;
    skos:topConceptOf mo:TipoPropulsionScheme .

mo:Electrica a skos:Concept ;
    skos:exactMatch edint-prop:Electric ;
    skos:inScheme mo:TipoPropulsionScheme ;
    skos:prefLabel "Electric"@en,
        "Eléctrica"@es ;
    skos:topConceptOf mo:TipoPropulsionScheme .

mo:Hibrida a skos:Concept ;
    skos:exactMatch edint-prop:Hybrid ;
    skos:inScheme mo:TipoPropulsionScheme ;
    skos:prefLabel "Hybrid"@en,
        "Híbrida"@es ;
    skos:topConceptOf mo:TipoPropulsionScheme .

mo:Humana a skos:Concept ;
    skos:inScheme mo:TipoPropulsionScheme ;
    skos:prefLabel "Human-powered"@en,
        "Humana"@es ;
    skos:topConceptOf mo:TipoPropulsionScheme .

mo:TipoPropulsionScheme a skos:ConceptScheme ;
    skos:hasTopConcept mo:Combustion,
        mo:Electrica,
        mo:Hibrida,
        mo:Humana ;
    skos:prefLabel "Propulsion types"@en,
        "Tipos de propulsión"@es .


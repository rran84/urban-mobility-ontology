mo:moneda a owl:DatatypeProperty ;
    rdfs:range xsd:string .

mo:nUsos a owl:DatatypeProperty ;
    rdfs:domain mo:TarifaBonoPrepago ;
    rdfs:range xsd:integer .

mo:nombreAgente a owl:DatatypeProperty ;
    rdfs:domain mo:Agentes ;
    rdfs:range xsd:string .

mo:nombrePunto a owl:DatatypeProperty ;
    rdfs:domain mo:PuntoDeServicio ;
    rdfs:range xsd:string .

mo:nombreServicio a owl:DatatypeProperty ;
    rdfs:domain mo:ServicioDeMovilidad ;

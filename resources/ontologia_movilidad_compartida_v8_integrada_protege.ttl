    rdfs:domain mo:VehiculoCompartido ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso mo:EstadoVehiculoScheme .

mo:tieneMetodoPago a owl:ObjectProperty ;
    rdfs:comment "Los valores son conceptos del esquema segittur:PaymentMethod de SEGITTUR."@es ;
    rdfs:domain mo:Pago ;

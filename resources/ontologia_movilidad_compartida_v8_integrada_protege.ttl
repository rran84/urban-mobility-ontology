mo:emitidaA a owl:ObjectProperty ;
    rdfs:domain mo:Factura ;
    rdfs:range mo:Agentes .

mo:emitidaPor a owl:ObjectProperty ;
    rdfs:domain mo:Factura ;
    rdfs:range mo:Agentes .

mo:estacionadoEn a owl:ObjectProperty ;

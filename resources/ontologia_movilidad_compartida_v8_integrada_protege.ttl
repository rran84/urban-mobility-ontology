    rdfs:range mo:Reserva .

mo:hasDestination a owl:ObjectProperty ;
    rdfs:domain mo:MultiStopRelation ;
    rdfs:range mo:PuntoDeServicio .

mo:hasMultiStop a owl:ObjectProperty ;
    rdfs:domain mo:Trayecto ;
    rdfs:range mo:MultiStopRelation .

mo:hasNextStop a owl:ObjectProperty ;
    rdfs:domain mo:MultiStopRelation ;
    rdfs:range mo:MultiStopRelation .

mo:idAgente a owl:DatatypeProperty ;
    rdfs:domain mo:Agentes ;
    rdfs:range xsd:string .

mo:idFactura a owl:DatatypeProperty ;
    rdfs:domain mo:Factura ;
    rdfs:range xsd:string .

mo:idPago a owl:DatatypeProperty ;
    rdfs:domain mo:Pago ;
    rdfs:range xsd:string .

mo:idPunto a owl:DatatypeProperty ;
    rdfs:domain mo:PuntoDeServicio ;
    rdfs:range xsd:string .

mo:idReserva a owl:DatatypeProperty ;
    rdfs:domain mo:Reserva ;
    rdfs:range xsd:string .

mo:idServicio a owl:DatatypeProperty ;
    rdfs:domain mo:ServicioDeMovilidad ;
    rdfs:range xsd:string .

mo:idTarifa a owl:DatatypeProperty ;
    rdfs:domain mo:Tarifa ;
    rdfs:range xsd:string .

mo:idTrayecto a owl:DatatypeProperty ;
    rdfs:domain mo:Trayecto ;
    rdfs:range xsd:string .

mo:idVehiculo a owl:DatatypeProperty ;
    rdfs:domain mo:VehiculoCompartido ;
    rdfs:range xsd:string .

mo:importe a owl:DatatypeProperty ;
    rdfs:domain mo:Pago ;
    rdfs:range xsd:decimal .

mo:importeTotal a owl:DatatypeProperty ;
    rdfs:domain mo:Factura ;
    rdfs:range xsd:decimal .

mo:inicioUso a owl:DatatypeProperty ;
    rdfs:domain mo:ReservaInmediata ;
    rdfs:range xsd:dateTime .

mo:kilometraje a owl:DatatypeProperty ;
    rdfs:domain mo:VehiculoCompartido ;
    rdfs:range xsd:decimal .

mo:latitud a owl:DatatypeProperty ;
    rdfs:domain mo:PuntoDeServicio ;

mo:tipoEstacion a owl:ObjectProperty ;
    rdfs:comment "Los valores son conceptos del esquema segittur:StationType de SEGITTUR."@es ;
    rdfs:domain mo:PuntoDeServicio ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso segittur:StationType .

mo:tipoVehiculo a owl:ObjectProperty ;
    rdfs:comment "Los valores son conceptos del esquema segittur:VehicleType de SEGITTUR."@es ;
    rdfs:domain mo:VehiculoCompartido ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso segittur:VehicleType .

mo:validez a owl:DatatypeProperty ;
    rdfs:domain mo:TarifaBonoPrepago ;
    rdfs:range xsd:date .

mo:ReservaInmediata a owl:Class ;
    rdfs:subClassOf mo:Reserva .

mo:TarifaBonoPrepago a owl:Class ;
    rdfs:subClassOf mo:Tarifa .

mo:TarifaPagoUso a owl:Class ;
    rdfs:subClassOf mo:Tarifa .

mo:EstacionFisica a owl:Class ;
    rdfs:subClassOf mo:PuntoDeServicio .

mo:Organizacion a owl:Class ;
    rdfs:subClassOf mo:Agentes ;
    owl:equivalentClass <http://purl.org/goodrelations/v1#BusinessEntity> .

mo:ReservaAnticipada a owl:Class ;
    rdfs:subClassOf mo:Reserva .

mo:Rol a owl:Class .

mo:TarifaSuscripcion a owl:Class ;
    rdfs:subClassOf mo:Tarifa .

mo:Trayecto a owl:Class .

mo:MultiStopRelation a owl:Class .

mo:tienePropulsion a owl:ObjectProperty ;
    rdfs:comment "Los valores son conceptos del esquema mo:TipoPropulsionScheme."@es ;
    rdfs:domain mo:VehiculoCompartido ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso mo:TipoPropulsionScheme .

mo:Pago a owl:Class .

mo:Persona a owl:Class ;
    rdfs:subClassOf mo:Agentes ;
    owl:equivalentClass foaf:Person .

mo:RelacionTrayecto a owl:Class .

mo:Tarifa a owl:Class .

mo:Agentes a owl:Class .

mo:Factura a owl:Class .

mo:Reserva a owl:Class .

mo:ServicioDeMovilidad a owl:Class .

mo:PuntoDeServicio a owl:Class ;
    rdfs:subClassOf sg:TransportInfrastructure .

mo:VehiculoCompartido a owl:Class .

# Bloque de infraestructura y horarios SEGITTUR (IRIs oficiales de las capturas).
# Declaraciones locales parciales, no owl:imports. Se mantiene GeoSPARQL sin cambios.
sg:Place a owl:Class .
sg:TransportInfrastructure a owl:Class ;
    rdfs:subClassOf sg:Place .
sg:OpeningHours a owl:Class .
sg:DayOfTheWeek a owl:Class .

sg:dayOfTheWeek a owl:ObjectProperty ;
    rdfs:domain sg:OpeningHours ;
    rdfs:range sg:DayOfTheWeek .
sg:Localizacion a owl:Class .
geo:Feature a owl:Class .
geo:Geometry a owl:Class .

sg:hasOpeningHours a owl:ObjectProperty ;
    rdfs:domain sg:Place ;
    rdfs:range sg:OpeningHours .
sg:tieneLocalizacion a owl:ObjectProperty ;
    rdfs:domain sg:Place ;
    rdfs:range sg:Localizacion .
sg:hasFeature a owl:ObjectProperty ;
    rdfs:domain sg:Localizacion ;
    rdfs:range geo:Feature .
sg:hasGeometry a owl:ObjectProperty ;
    rdfs:domain geo:Feature ;
    rdfs:range geo:Geometry .

sg:comarca a owl:DatatypeProperty ; rdfs:domain sg:Localizacion ; rdfs:range xsd:string .
sg:comunidadAutonoma a owl:DatatypeProperty ; rdfs:domain sg:Localizacion ; rdfs:range xsd:string .
sg:codigoPostal a owl:DatatypeProperty ; rdfs:domain sg:Localizacion ; rdfs:range xsd:string .
sg:direccionLocalizacion a owl:DatatypeProperty ; rdfs:domain sg:Localizacion ; rdfs:range xsd:string .
sg:localidad a owl:DatatypeProperty ; rdfs:domain sg:Localizacion ; rdfs:range xsd:string .
sg:pais a owl:DatatypeProperty ; rdfs:domain sg:Localizacion ; rdfs:range xsd:string .
sg:provincia a owl:DatatypeProperty ; rdfs:domain sg:Localizacion ; rdfs:range xsd:string .

# Etiquetas geoLat y geoLong del diagrama: nombres provisionales hasta contrastar IRIs.
geo:geoLat a owl:DatatypeProperty ; rdfs:domain geo:Geometry ; rdfs:range xsd:string .
geo:geoLong a owl:DatatypeProperty ; rdfs:domain geo:Geometry ; rdfs:range xsd:string .
geo:asWKT a owl:DatatypeProperty ; rdfs:domain geo:Geometry ; rdfs:range xsd:string .
geo:asGeoJSON a owl:DatatypeProperty ; rdfs:domain geo:Geometry ; rdfs:range xsd:string .

# === Fuente: skos/edint/propulsionsystemtype.ttl ===
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix edintvehcom: <https://edint.es/def/vehiculos-compartidos#> .
@prefix edint: <https://edint.es/kos/> .
@prefix edintpropulsionsystemtype: <https://edint.es/kos/PropulsionSystemType/> .

#################################################################
#
#    Concept Scheme
#
#################################################################

edint:PropulsionSystemType a skos:ConceptScheme ;
  dct:issued "2026-05-21"^^xsd:date ;
  dct:modified "2026-05-21"^^xsd:date ;
  rdfs:comment "This concept scheme belongs to the set of controlled SKOS-based thesauri used by the ontologies from the EDINT data space."@en ;
  rdfs:comment "Este esquema de conceptos pertenece al conjunto de tesauros SKOS usados por las ontologías del espacio de datos EDINT."@es ;
  rdfs:label "Propulsion system type"@en ;
  rdfs:label "Tipo de sistema de propulsión"@es ;
  dct:title "Concept scheme grouping propulsion system types"@en ;
  dct:title "Esquema de conceptos agrupando tipos de sistema de propulsión"@es .

#################################################################
#
#    Concepts
#
#################################################################

edintpropulsionsystemtype:Electric a skos:Concept ;
  skos:inScheme edint:PropulsionSystemType ;
  skos:prefLabel "Electric"@en ;
  skos:prefLabel "Eléctrico"@es .

edintpropulsionsystemtype:Diesel a skos:Concept ;
  skos:inScheme edint:PropulsionSystemType ;
  skos:prefLabel "Diesel"@en ;
  skos:prefLabel "Diesel"@es .

edintpropulsionsystemtype:Gasoline a skos:Concept ;
  skos:inScheme edint:PropulsionSystemType ;
  skos:prefLabel "Gasoline"@en ;
  skos:prefLabel "Gasolina"@es .

edintpropulsionsystemtype:Hybrid a skos:Concept ;
  skos:inScheme edint:PropulsionSystemType ;
  skos:prefLabel "Hybrid"@en ;
  skos:prefLabel "Híbrido"@es .


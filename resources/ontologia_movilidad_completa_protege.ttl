    rdfs:domain mo:ServicioDeMovilidad ;
    rdfs:range xsd:string .

mo:idTarifa a owl:DatatypeProperty ;
    rdfs:domain mo:Tarifa ;
    rdfs:range xsd:string .

mo:idTrayecto a owl:DatatypeProperty ;
    rdfs:domain mo:Trayecto ;
    rdfs:range xsd:string .

mo:idVehiculo a owl:DatatypeProperty ;
    rdfs:domain mo:VehiculoCompartido ;
    rdfs:range xsd:string .

mo:importe a owl:DatatypeProperty ;
    rdfs:domain mo:Pago ;
    rdfs:range xsd:decimal .

mo:importeTotal a owl:DatatypeProperty ;
    rdfs:domain mo:Factura ;
    rdfs:range xsd:decimal .

mo:inicioUso a owl:DatatypeProperty ;
    rdfs:domain mo:ReservaInmediata ;
    rdfs:range xsd:dateTime .

mo:kilometraje a owl:DatatypeProperty ;
    rdfs:domain mo:VehiculoCompartido ;
    rdfs:range xsd:decimal .


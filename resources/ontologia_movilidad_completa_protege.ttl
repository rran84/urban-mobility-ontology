mo:pagadoCon a owl:ObjectProperty ;
    rdfs:comment "Los valores son conceptos del esquema segittur:PaymentMethod de SEGITTUR."@es ;
    rdfs:domain mo:Tarifa ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso segittur:PaymentMethod .

mo:pendientePago a owl:DatatypeProperty ;
    rdfs:domain mo:Factura ;
    rdfs:range xsd:boolean .

mo:permisoConducir a owl:DatatypeProperty ;

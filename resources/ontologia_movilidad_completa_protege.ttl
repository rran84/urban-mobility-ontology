    rdfs:domain mo:VehiculoCompartido ;
    rdfs:range mo:PuntoDeServicio .

mo:facturaServicio a owl:ObjectProperty ;
    rdfs:domain mo:Factura ;
    rdfs:range mo:ServicioDeMovilidad .

mo:facturaTrayecto a owl:ObjectProperty ;
    rdfs:domain mo:Factura ;
    rdfs:range mo:RelacionTrayecto .

mo:fechaEmision a owl:DatatypeProperty ;
    rdfs:domain mo:Factura ;
    rdfs:range xsd:dateTime .

mo:fechaFin a owl:DatatypeProperty ;
    rdfs:domain mo:ReservaAnticipada ;
    rdfs:range xsd:dateTime .

mo:fechaInicio a owl:DatatypeProperty ;
    rdfs:domain mo:ReservaAnticipada ;
    rdfs:range xsd:dateTime .

mo:fechaNacimiento a owl:DatatypeProperty ;
    rdfs:domain mo:Persona ;
    rdfs:range xsd:date .

mo:fechaPago a owl:DatatypeProperty ;
    rdfs:domain mo:Pago ;
    rdfs:range xsd:dateTime .

mo:fechaReserva a owl:DatatypeProperty ;
    rdfs:domain mo:Reserva ;

mo:tienePago a owl:ObjectProperty ;
    rdfs:domain mo:Factura ;
    rdfs:range mo:Pago .

mo:tieneRol a owl:ObjectProperty ;
    rdfs:domain mo:Agentes ;
    rdfs:range mo:Rol .

mo:tieneTarifa a owl:ObjectProperty ;
    rdfs:domain mo:ServicioDeMovilidad ;
    rdfs:range mo:Tarifa .

mo:tieneTrayecto a owl:ObjectProperty ;
    rdfs:domain mo:ServicioDeMovilidad ;

    rdfs:range xsd:integer .

mo:nombreAgente a owl:DatatypeProperty ;
    rdfs:domain mo:Agentes ;
    rdfs:range xsd:string .

mo:nombrePunto a owl:DatatypeProperty ;
    rdfs:domain mo:PuntoDeServicio ;
    rdfs:range xsd:string .

mo:nombreServicio a owl:DatatypeProperty ;

    rdfs:domain mo:TarifaPagoUso ;
    rdfs:range xsd:decimal .

mo:precioMinuto a owl:DatatypeProperty ;
    rdfs:domain mo:TarifaPagoUso ;
    rdfs:range xsd:decimal .

mo:puntoDevolucion a owl:ObjectProperty ;
    rdfs:domain mo:ServicioDeMovilidad ;
    rdfs:range mo:PuntoDeServicio .

mo:puntoRecogida a owl:ObjectProperty ;

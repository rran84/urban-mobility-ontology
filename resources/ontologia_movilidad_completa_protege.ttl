@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix edintvehcom: <https://edint.es/def/vehiculos-compartidos#> .
@prefix edint: <https://edint.es/kos/> .
@prefix edintvehiclestate: <https://edint.es/kos/VehicleState/> .

#################################################################
#
#    Concept Scheme
#
#################################################################

edint:VehicleState a skos:ConceptScheme ;
  dct:issued "2026-05-21"^^xsd:date ;
  dct:modified "2026-05-21"^^xsd:date ;
  rdfs:comment "This concept scheme belongs to the set of controlled SKOS-based thesauri used by the ontologies from the EDINT data space."@en ;
  rdfs:comment "Este esquema de conceptos pertenece al conjunto de tesauros SKOS usados por las ontologías del espacio de datos EDINT."@es ;
  rdfs:label "Vehicle state"@en ;
  rdfs:label "Estado del vehículo"@es ;
  dct:title "Concept scheme grouping vehicle states"@en ;
  dct:title "Esquema de conceptos agrupando estados de vehículo"@es .

#################################################################
#
#    Concepts
#
#################################################################

edintvehiclestate:Active a skos:Concept ;
  skos:inScheme edint:VehicleState ;
  skos:prefLabel "Active"@en ;
  skos:prefLabel "Activo"@es .

edintvehiclestate:Inactive a skos:Concept ;
  skos:inScheme edint:VehicleState ;
  skos:prefLabel "Inactive"@en ;
  skos:prefLabel "Inactivo"@es .

edintvehiclestate:UnderRepair a skos:Concept ;
  skos:inScheme edint:VehicleState ;
  skos:prefLabel "Under repair"@en ;
  skos:prefLabel "En reparación"@es .

edintvehiclestate:Abandoned a skos:Concept ;
  skos:inScheme edint:VehicleState ;
  skos:prefLabel "Abandoned"@en ;
  skos:prefLabel "Abandonado"@es .

# === Fuente: skos/propios/estado_vehiculo.ttl ===
@prefix edint-estado: <https://edint.es/kos/VehicleState/> .
@prefix mo: <http://movilidad.es/def/compartida#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

mo:Disponible a skos:Concept ;
    skos:inScheme mo:EstadoVehiculoScheme ;
    skos:prefLabel "Available"@en,
        "Disponible"@es ;
    skos:topConceptOf mo:EstadoVehiculoScheme .

mo:Mantenimiento a skos:Concept ;
    skos:closeMatch edint-estado:UnderRepair ;
    skos:inScheme mo:EstadoVehiculoScheme ;
    skos:prefLabel "Under maintenance"@en,
        "Mantenimiento"@es ;
    skos:topConceptOf mo:EstadoVehiculoScheme .

mo:Ocupado a skos:Concept ;
    skos:inScheme mo:EstadoVehiculoScheme ;
    skos:prefLabel "Occupied"@en,
        "Ocupado"@es ;
    skos:topConceptOf mo:EstadoVehiculoScheme .

mo:EstadoVehiculoScheme a skos:ConceptScheme ;
    skos:hasTopConcept mo:Disponible,
        mo:Mantenimiento,
        mo:Ocupado ;
    skos:prefLabel "Vehicle status"@en,
        "Estado del vehículo"@es .

# === Fuente: skos/propios/tipo_propulsion.ttl ===
@prefix edint-prop: <https://edint.es/kos/PropulsionSystemType/> .
@prefix mo: <http://movilidad.es/def/compartida#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

mo:Combustion a skos:Concept ;
    skos:inScheme mo:TipoPropulsionScheme ;
    skos:narrowMatch edint-prop:Diesel,
        edint-prop:Gasoline ;
    skos:prefLabel "Combustion"@en,
        "Combustión"@es ;
    skos:topConceptOf mo:TipoPropulsionScheme .

mo:Electrica a skos:Concept ;
    skos:exactMatch edint-prop:Electric ;
    skos:inScheme mo:TipoPropulsionScheme ;
    skos:prefLabel "Electric"@en,
        "Eléctrica"@es ;
    skos:topConceptOf mo:TipoPropulsionScheme .

mo:Hibrida a skos:Concept ;
    skos:exactMatch edint-prop:Hybrid ;
    skos:inScheme mo:TipoPropulsionScheme ;
    skos:prefLabel "Hybrid"@en,
        "Híbrida"@es ;
    skos:topConceptOf mo:TipoPropulsionScheme .

mo:Humana a skos:Concept ;
    skos:inScheme mo:TipoPropulsionScheme ;
    skos:prefLabel "Human-powered"@en,
        "Humana"@es ;
    skos:topConceptOf mo:TipoPropulsionScheme .

mo:TipoPropulsionScheme a skos:ConceptScheme ;
    skos:hasTopConcept mo:Combustion,
        mo:Electrica,
        mo:Hibrida,
        mo:Humana ;
    skos:prefLabel "Propulsion types"@en,
        "Tipos de propulsión"@es .


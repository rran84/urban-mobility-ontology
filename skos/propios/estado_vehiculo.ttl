@prefix edint-estado: <https://edint.es/kos/VehicleState/> .
@prefix mo: <http://movilidad.es/def/compartida#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

mo:Disponible a skos:Concept ;
    skos:inScheme mo:EstadoVehiculoScheme ;
    skos:prefLabel "Available"@en,
        "Disponible"@es ;
    skos:topConceptOf mo:EstadoVehiculoScheme .

mo:Mantenimiento a skos:Concept ;
    skos:closeMatch edint-estado:UnderRepair ;
    skos:inScheme mo:EstadoVehiculoScheme ;
    skos:prefLabel "Under maintenance"@en,
        "Mantenimiento"@es ;
    skos:topConceptOf mo:EstadoVehiculoScheme .

mo:Ocupado a skos:Concept ;
    skos:inScheme mo:EstadoVehiculoScheme ;
    skos:prefLabel "Occupied"@en,
        "Ocupado"@es ;
    skos:topConceptOf mo:EstadoVehiculoScheme .

mo:EstadoVehiculoScheme a skos:ConceptScheme ;
    skos:hasTopConcept mo:Disponible,
        mo:Mantenimiento,
        mo:Ocupado ;
    skos:prefLabel "Vehicle status"@en,
        "Estado del vehículo"@es .

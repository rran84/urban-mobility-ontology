@prefix edint-prop: <https://edint.es/kos/PropulsionSystemType/> .
@prefix mo: <http://movilidad.es/def/compartida#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

mo:Combustion a skos:Concept ;
    skos:inScheme mo:TipoPropulsionScheme ;
    skos:narrowMatch edint-prop:Diesel,
        edint-prop:Gasoline ;
    skos:prefLabel "Combustion"@en,
        "Combustión"@es ;
    skos:topConceptOf mo:TipoPropulsionScheme .

mo:Electrica a skos:Concept ;
    skos:exactMatch edint-prop:Electric ;
    skos:inScheme mo:TipoPropulsionScheme ;
    skos:prefLabel "Electric"@en,
        "Eléctrica"@es ;
    skos:topConceptOf mo:TipoPropulsionScheme .

mo:Hibrida a skos:Concept ;
    skos:exactMatch edint-prop:Hybrid ;
    skos:inScheme mo:TipoPropulsionScheme ;
    skos:prefLabel "Hybrid"@en,
        "Híbrida"@es ;
    skos:topConceptOf mo:TipoPropulsionScheme .

mo:Humana a skos:Concept ;
    skos:inScheme mo:TipoPropulsionScheme ;
    skos:prefLabel "Human-powered"@en,
        "Humana"@es ;
    skos:topConceptOf mo:TipoPropulsionScheme .

mo:TipoPropulsionScheme a skos:ConceptScheme ;
    skos:hasTopConcept mo:Combustion,
        mo:Electrica,
        mo:Hibrida,
        mo:Humana ;
    skos:prefLabel "Propulsion types"@en,
        "Tipos de propulsión"@es .
